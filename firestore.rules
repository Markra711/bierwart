rules_version = '2';

// Security Rules für Bierwart, Release 1 ohne Cloud Functions (ADR-0009).
// Die Rules sind die Geschäftslogik: Jede Buchung ist ein Batch aus Buchung
// und Summen, und die Rules prüfen, dass beides zusammenpasst.
// Muster und Wirkungen: docs/architecture.md, „Summen“ und „Buchungen“.
// Tests: rules-tests/.
//
// Stand: Buchungen, Stammdaten (Mitglieder, Namen, Sorten), Mitgliedschaft
// (Kasse erstellen, Beitreten, Übernahme, Austreten) und Admin-Funktionen
// (Link erneuern, Bierwart entfernen, Rollen, Umbenennen, Wiederherstellung
// samt Nachweis, Auflösen).
service cloud.firestore {
  match /databases/{database}/documents {

    match /kassen/{k} {
      function kassePfad() {
        return /databases/$(database)/documents/kassen/$(k);
      }
      function pfad(sammlung, id) {
        return /databases/$(database)/documents/kassen/$(k)/$(sammlung)/$(id);
      }
      function nachher(sammlung, id) {
        return getAfter(pfad(sammlung, id)).data;
      }
      function istBierwart() {
        return request.auth != null && exists(pfad('bierwarte', request.auth.uid));
      }
      // Auch wer im selben Batch Bierwart wird (Kasse erstellen, Beitreten).
      function istOderWirdBierwart() {
        return request.auth != null && existsAfter(pfad('bierwarte', request.auth.uid));
      }
      function istAdmin() {
        return request.auth != null && get(kassePfad()).data.adminUid == request.auth.uid;
      }
      function aufgeloest() {
        return exists(kassePfad()) && get(kassePfad()).data.get('aufgeloest', false) == true;
      }
      // Wer den Wiederherstellungscode kennt, aber kein Bierwart ist, darf
      // lesen, solange sein Nachweis zum aktuellen Code passt. Er braucht die
      // Kasse, um den Batch der Wiederherstellung zu bauen (ADR-0010).
      function hatNachweis() {
        return request.auth != null
          && exists(pfad('wiederherstellungen', request.auth.uid))
          && hashing.sha256(get(pfad('wiederherstellungen', request.auth.uid)).data.nachweis)
            == get(kassePfad()).data.wiederherstellungHash;
      }
      // Eine aufgelöste Kasse sieht nur noch der Admin, der sie löscht (ADM-05).
      function darfLesen() {
        return (istBierwart() || hatNachweis()) && (!aufgeloest() || istAdmin());
      }
      function istKassenwart() {
        return get(/databases/$(database)/documents/kassen/$(k)).data.kassenwartUid == request.auth.uid;
      }
      // Eigenes Portemonnaie, als Kassenwart auch die Kasse (ADR-0004).
      function ortErlaubt(ortId) {
        return ortId == request.auth.uid || (ortId == 'kasse' && istKassenwart());
      }
      function betragGueltig(betrag) {
        return betrag is int && betrag > 0;   // ADR-0002
      }

      // ---- Summen -----------------------------------------------------------

      // Die Buchung, auf die ein Summen-Dokument verweist, muss in genau
      // diesem Request entstehen: Ihr Serverzeitstempel ist request.time.
      function buchungDiesesRequests() {
        let b = nachher('buchungen', request.resource.data.letzteBuchungId);
        return b.stempel.am == request.time ? b : null;
      }
      function nurFelder(felder) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(felder);
      }
      function delta(feld) {
        return request.resource.data[feld] - resource.data[feld];
      }
      function summeGeaendert(feld, wirkung) {
        return nurFelder([feld, 'letzteBuchungId'])
          && wirkung == delta(feld);
      }

      // Wirkung einer Buchung b auf den Saldo eines Mitglieds.
      function saldoWirkung(b, mitgliedId) {
        return b.get('mitgliedId', '') != mitgliedId ? 0
          : b.typ == 'strich' ? b.preisCents
          : b.typ == 'zahlung' ? -b.betragCents
          : b.typ == 'storno' && b.bezugTyp == 'strich' ? -b.preisCents
          : b.typ == 'storno' && b.bezugTyp == 'zahlung' ? b.betragCents
          : 0;
      }

      // Wirkung auf den Bestand einer Sorte. Absolute Buchungen
      // (bestandKorrektur) wirken mit ihrer Differenz.
      function bestandWirkung(b, sorteId) {
        return (b.typ == 'strich' || b.typ == 'strichBar') && b.sorteId == sorteId ? -1
          : b.typ == 'storno' && b.sorteId == sorteId ? 1
          : b.typ == 'einkauf' ? b.zeilen.get(sorteId, 0)
          : b.typ == 'bestandKorrektur' && b.sorteId == sorteId ? b.differenz
          : 0;
      }

      // Wirkung auf den Stand eines Orts (Kasse oder Portemonnaie).
      function standWirkung(b, ortId) {
        return b.typ == 'uebergabe' ?
            (b.vonOrtId == ortId ? -b.betragCents : b.nachOrtId == ortId ? b.betragCents : 0)
          : b.typ == 'kassensturz' ? (ortId == 'kasse' ? b.differenzCents : 0)
          : b.typ == 'uebernahmeBestaetigt' ? (ortId == b.alteUid ? -b.standCents : 0)
          : b.get('ortId', '') != ortId ? 0
          : b.typ == 'strichBar' ? b.preisCents
          : b.typ == 'storno' && b.bezugTyp == 'strichBar' ? -b.preisCents
          : b.typ == 'storno' && b.bezugTyp == 'zahlung' ? -b.betragCents
          : b.typ == 'zahlung' ? b.betragCents
          : b.typ == 'einkauf' ? -b.betragCents
          : b.typ == 'einzahlung' ? b.betragCents
          : b.typ == 'auszahlung' ? -b.betragCents
          : 0;
      }

      allow read: if darfLesen();

      // ---- Kasse und Mitgliedschaft ----------------------------------------
      // Einladungen und Übernahme-Anfragen gelten 7 Tage ab dem Serverzeitpunkt
      // (AUTH-08, ADR-0008). Ein Client kann request.time + 7 Tage nicht
      // schreiben, deshalb rechnen die Rules.

      function siebenTage() {
        return duration.value(7, 'd');
      }
      // Aktueller, nicht ersetzter und nicht abgelaufener Link (AUTH-08).
      function einladungGueltig(code) {
        let kasse = get(kassePfad()).data;
        let e = get(/databases/$(database)/documents/einladungen/$(code)).data;
        return kasse.einladungCode == code
          && kasse.get('aufgeloest', false) == false
          && e.kasseId == k
          && e.ersetzt == false
          && request.time < e.erstelltAm + siebenTage();
      }

      // Kasse erstellen (UC-01, AUTH-02, AUTH-03): Ersteller ist Admin und
      // Kassenwart. Einladung und Wiederherstellung entstehen im selben Batch.
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['name', 'adminUid', 'kassenwartUid', 'einladungCode', 'anzahlBierwarte', 'wiederherstellungHash', 'leerSeit', 'aufgeloest', 'erstelltAm', 'letzteBuchungId'])
        && request.resource.data.keys().hasAll(['name', 'adminUid', 'kassenwartUid', 'einladungCode', 'anzahlBierwarte', 'wiederherstellungHash', 'leerSeit', 'aufgeloest', 'erstelltAm', 'letzteBuchungId'])
        && nameGueltig(request.resource.data.name)
        && request.resource.data.adminUid == request.auth.uid
        && request.resource.data.kassenwartUid == request.auth.uid
        && request.resource.data.anzahlBierwarte == 1
        && request.resource.data.leerSeit == null
        && request.resource.data.aufgeloest == false
        && request.resource.data.erstelltAm == request.time
        // URL-sicher, mindestens 96 Bit Zufall (siehe Einladungslinks)
        && request.resource.data.einladungCode is string
        && request.resource.data.einladungCode.matches('[A-Za-z0-9_-]{16,64}')
        && getAfter(/databases/$(database)/documents/einladungen/$(request.resource.data.einladungCode)).data.kasseId == k
        // SHA-256 des normalisierten Codes; Dokument-ID ist das Hex klein geschrieben
        && request.resource.data.wiederherstellungHash is bytes
        && request.resource.data.wiederherstellungHash.size() == 32
        && getAfter(/databases/$(database)/documents/wiederherstellung/$(request.resource.data.wiederherstellungHash.toHexString().lower())).data.kasseId == k
        && buchungDiesesRequests() != null
        && buchungDiesesRequests().typ == 'kasseErstellt';

      // Anzahl der Bierwarte und Rollen ändern sich nur mit ihrer Log-Buchung.
      // Die Anzahl in der Einladung zieht mit (AUTH-05).
      function kasseGeaendert(b) {
        let d = request.resource.data;
        return (b.typ == 'bierwartBeigetreten'                              // UC-02
            && nurFelder(['anzahlBierwarte', 'leerSeit', 'letzteBuchungId'])
            && delta('anzahlBierwarte') == 1
            && d.leerSeit == null)
          || (b.typ == 'ausgetreten'                                        // UC-05
            && nurFelder(['anzahlBierwarte', 'leerSeit', 'letzteBuchungId'])
            && delta('anzahlBierwarte') == -1
            && d.leerSeit == (d.anzahlBierwarte == 0 ? request.time : resource.data.leerSeit))
          // Übernahme (UC-03): Rollen und Anzahl prüft die Buchung
          || (b.typ == 'uebernahmeBestaetigt'
            && nurFelder(['anzahlBierwarte', 'adminUid', 'kassenwartUid', 'leerSeit', 'letzteBuchungId'])
            && d.leerSeit == null)
          || (b.typ == 'einladungErneuert'                                  // ADM-01
            && nurFelder(['einladungCode', 'letzteBuchungId'])
            && codeGueltig(d.einladungCode))
          || (b.typ == 'bierwartEntfernt'                                   // ADM-02
            && nurFelder(['anzahlBierwarte', 'einladungCode', 'letzteBuchungId'])
            && delta('anzahlBierwarte') == -1
            && codeGueltig(d.einladungCode))
          || (b.typ == 'rolleGeaendert'                                     // ADM-03
            && nurFelder([b.rolle == 'admin' ? 'adminUid' : 'kassenwartUid', 'letzteBuchungId']))
          || (b.typ == 'kasseUmbenannt'                                     // ADM-04
            && nurFelder(['name', 'letzteBuchungId'])
            && nameGueltig(d.name))
          || (b.typ == 'kasseAufgeloest'                                    // ADM-05
            && nurFelder(['aufgeloest', 'aufloesenBestaetigung', 'letzteBuchungId'])
            && d.aufgeloest == true
            && d.aufloesenBestaetigung == resource.data.name)
          // Wiederherstellung (ADM-06): Rollen und Anzahl prüft die Buchung
          || (b.typ == 'adminWiederhergestellt'
            && nurFelder(['adminUid', 'kassenwartUid', 'anzahlBierwarte', 'leerSeit', 'wiederherstellungHash', 'letzteBuchungId'])
            && d.leerSeit == null)
          || (b.typ == 'wiederherstellungscodeErneuert'                     // ADM-08
            && nurFelder(['wiederherstellungHash', 'letzteBuchungId']));
      }
      function codeGueltig(code) {
        return code is string && code.matches('[A-Za-z0-9_-]{16,64}');
      }
      function hashGueltig(hash) {
        return hash is bytes && hash.size() == 32;
      }
      // Einladung und Wiederherstellung zeigen nach jeder Änderung auf diese
      // Kasse; die Einladung zeigt Name und Anzahl (AUTH-05).
      allow update: if buchungDiesesRequests() != null
        && kasseGeaendert(buchungDiesesRequests())
        && getAfter(/databases/$(database)/documents/einladungen/$(request.resource.data.einladungCode)).data.kasseId == k
        && getAfter(/databases/$(database)/documents/einladungen/$(request.resource.data.einladungCode)).data.anzahlBierwarte == request.resource.data.anzahlBierwarte
        && getAfter(/databases/$(database)/documents/einladungen/$(request.resource.data.einladungCode)).data.kassenName == request.resource.data.name
        && hashGueltig(request.resource.data.wiederherstellungHash)
        && getAfter(/databases/$(database)/documents/wiederherstellung/$(request.resource.data.wiederherstellungHash.toHexString().lower())).data.kasseId == k;

      // Auflösen (ADM-05, UC-10): Erst wird die Kasse als aufgelöst markiert,
      // dann löscht die App des Admins alle Dokumente und zuletzt die Kasse.
      function loeschtAdmin() {
        return aufgeloest() && istAdmin();
      }
      allow delete: if loeschtAdmin();
      match /{sammlung}/{id} {
        allow delete: if loeschtAdmin();
      }

      // ---- Stammdaten ------------------------------------------------------
      // Jede Änderung verweist über letzteBuchungId auf ihre Log-Buchung im
      // selben Batch (LOG-01). Der Name im Index ist die normalisierte Form.

      function nameGueltig(name) {
        return name is string && name.trim().size() > 0 && name.size() <= 60;
      }
      function nameKey(name) {
        return name.lower().trim().replace('\\s+', ' ');
      }
      function nameIndexZeigtAuf(key, mitgliedId) {
        return nachher('namen', key).mitgliedId == mitgliedId;
      }

      match /bierwarte/{uid} {
        function neuerBierwart() {
          let d = request.resource.data;
          let b = buchungDiesesRequests();
          return b != null
            && d.keys().hasOnly(['mitgliedId', 'name', 'beigetretenAm', 'einladungCode', 'letzteBuchungId'])
            && d.keys().hasAll(['mitgliedId', 'name', 'beigetretenAm', 'einladungCode', 'letzteBuchungId'])
            && d.beigetretenAm == request.time
            && nachher('mitglieder', d.mitgliedId).bierwartUid == uid
            && nachher('mitglieder', d.mitgliedId).name == d.name
            && (
              // Kasse erstellen (UC-01) und Beitreten (UC-02, AUTH-08)
              ((b.typ == 'kasseErstellt' ? d.einladungCode == null : (b.typ == 'bierwartBeigetreten' && einladungGueltig(d.einladungCode)))
                && uid == request.auth.uid
                // Release 1: eine Kasse je Nutzer
                && getAfter(/databases/$(database)/documents/users/$(uid)).data.kasseId == k)
              // Übernahme bestätigt (UC-03, ADR-0008): angelegt vom Entscheider
              || (b.typ == 'uebernahmeBestaetigt' && b.neueUid == uid
                && d.einladungCode == get(pfad('uebernahmen', b.uebernahmeId)).data.einladungCode)
              // Wiederherstellung ohne Bierwart-Eintrag (ADM-06, UC-03)
              || (b.typ == 'adminWiederhergestellt' && b.neueUid == uid
                && uid == request.auth.uid && d.einladungCode == null
                && getAfter(/databases/$(database)/documents/users/$(uid)).data.kasseId == k));
        }
        function buchungUeber(buchungId) {
          let b = nachher('buchungen', buchungId);
          return b.stempel.am == request.time ? b : null;
        }
        function ausgetretenOderEntfernt() {
          let b = buchungUeber(getAfter(kassePfad()).data.letzteBuchungId);
          return b != null
            && ((b.typ == 'ausgetreten' && b.stempel.uid == uid)
              || (b.typ == 'bierwartEntfernt' && b.uid == uid));
        }
        function alteUidUebernommen() {
          let b = buchungUeber(nachher('mitglieder', resource.data.mitgliedId).letzteBuchungId);
          return b != null
            && (b.typ == 'uebernahmeBestaetigt' || b.typ == 'adminWiederhergestellt')
            && b.alteUid == uid;
        }

        allow read: if darfLesen();
        allow create: if neuerBierwart();
        // Austreten (UC-05), Entfernen (ADM-02) oder alte UID nach einer
        // Übernahme (ADR-0008, ADM-06)
        allow delete: if request.auth != null && (ausgetretenOderEntfernt() || alteUidUebernommen());
        // Name des Bierwarts folgt der Umbenennung seines Mitglieds (UI-09).
        allow update: if buchungDiesesRequests() != null
          && nurFelder(['name', 'letzteBuchungId'])
          && buchungDiesesRequests().typ == 'mitgliedUmbenannt'
          && buchungDiesesRequests().mitgliedId == resource.data.mitgliedId
          && request.resource.data.name == buchungDiesesRequests().nameNeu;
      }

      match /mitglieder/{mitgliedId} {
        function stammdatenBuchung(typ) {
          let b = buchungDiesesRequests();
          return b != null && b.typ == typ && b.mitgliedId == mitgliedId;
        }
        function bierwartFolgt(neu) {
          return resource.data.get('bierwartUid', null) == null
            || !exists(pfad('bierwarte', resource.data.bierwartUid))
            || nachher('bierwarte', resource.data.bierwartUid).name == neu.name;
        }
        function bierwartAktiv() {
          return resource.data.get('bierwartUid', null) != null
            && exists(pfad('bierwarte', resource.data.bierwartUid));
        }

        allow read: if darfLesen();

        // Neues Mitglied: Saldo 0, Name im Index.
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['name', 'nameKey', 'istGast', 'bierwartUid', 'entfernt', 'saldoCents', 'letzteBuchungId', 'angelegtAm'])
          && nameGueltig(request.resource.data.name)
          && request.resource.data.nameKey == nameKey(request.resource.data.name)
          && request.resource.data.entfernt == false
          && request.resource.data.saldoCents == 0
          && request.resource.data.angelegtAm == request.time
          && nameIndexZeigtAuf(request.resource.data.nameKey, mitgliedId)
          && (
            // Anlegen (KAD-01): kein Gast, kein Bierwart
            (istBierwart()
              && request.resource.data.istGast == false
              && request.resource.data.bierwartUid == null
              && stammdatenBuchung('mitgliedAngelegt'))
            // Eigenes Mitglied beim Erstellen und Beitreten (KAD-02)
            || (request.resource.data.istGast == false
              && request.resource.data.bierwartUid == request.auth.uid
              && nachher('bierwarte', request.auth.uid).mitgliedId == mitgliedId
              && (stammdatenBuchung('kasseErstellt') || stammdatenBuchung('bierwartBeigetreten')
                || stammdatenBuchung('adminWiederhergestellt')))
            // „Gäste“ entsteht mit der Kasse (KAD-03)
            || (mitgliedId == 'gaeste'
              && request.resource.data.name == 'Gäste'
              && request.resource.data.istGast == true
              && request.resource.data.bierwartUid == null
              && buchungDiesesRequests() != null
              && buchungDiesesRequests().typ == 'kasseErstellt'));

        allow update: if
          // Summen aus Buchungen
          (buchungDiesesRequests() != null
            && summeGeaendert('saldoCents', saldoWirkung(buchungDiesesRequests(), mitgliedId)))
          // Umbenennen (KAD-01, UI-09): neuer Name im Index, alter frei. Nur
          // die Schreibweise (gleicher Schlüssel): Der Index bleibt (offene
          // Frage 26).
          || (nurFelder(['name', 'nameKey', 'letzteBuchungId'])
            && resource.data.get('istGast', false) == false
            && resource.data.entfernt == false   // sonst würde ein reservierter Name frei (KAD-08)
            && nameGueltig(request.resource.data.name)
            && request.resource.data.nameKey == nameKey(request.resource.data.name)
            && (request.resource.data.nameKey != resource.data.nameKey
              ? nameIndexZeigtAuf(request.resource.data.nameKey, mitgliedId)
                && !existsAfter(pfad('namen', resource.data.nameKey))
              : request.resource.data.name != resource.data.name
                && nameIndexZeigtAuf(request.resource.data.nameKey, mitgliedId))
            && bierwartFolgt(request.resource.data)
            && stammdatenBuchung('mitgliedUmbenannt'))
          // Entfernen (KAD-04): nur bei Saldo 0, nie Gäste, nie aktive Bierwarte (KAD-02).
          // Der Name bleibt im Index reserviert (KAD-08).
          || (nurFelder(['entfernt', 'letzteBuchungId'])
            && resource.data.entfernt == false && request.resource.data.entfernt == true
            && resource.data.saldoCents == 0
            && resource.data.get('istGast', false) == false
            && !bierwartAktiv()
            && stammdatenBuchung('mitgliedEntfernt'))
          // Wieder aufnehmen (KAD-08)
          || (nurFelder(['entfernt', 'letzteBuchungId'])
            && resource.data.entfernt == true && request.resource.data.entfernt == false
            && stammdatenBuchung('mitgliedWiederaufgenommen'))
          // Übernahme (UC-03, ADM-06): geht auf die neue UID über; ein
          // entferntes Mitglied wird dabei wieder aktiv (KAD-02, KAD-08)
          || (nurFelder(['bierwartUid', 'entfernt', 'letzteBuchungId'])
            && request.resource.data.entfernt == false
            && (stammdatenBuchung('uebernahmeBestaetigt') || stammdatenBuchung('adminWiederhergestellt'))
            && request.resource.data.bierwartUid == buchungDiesesRequests().neueUid);
      }

      match /namen/{key} {
        // Wer beitreten will, muss vorher sehen, ob sein Name vergeben ist, und
        // für „Das bin ich“ die mitgliedId kennen (AUTH-07). Nur per get, so
        // lassen sich die Namen einer Kasse nicht auflisten.
        allow get: if request.auth != null;
        allow list: if darfLesen();
        // Ein zweites create auf denselben Schlüssel ist ein update und scheitert:
        // so bleibt jeder Name pro Kasse eindeutig (AUTH-07, UI-09).
        allow create: if istOderWirdBierwart()
          && request.resource.data.keys().hasOnly(['mitgliedId'])
          && nachher('mitglieder', request.resource.data.mitgliedId).nameKey == key;
        // Frei wird ein Name nur, wenn sein Mitglied im selben Batch umbenannt wird.
        allow delete: if istBierwart()
          && nachher('mitglieder', resource.data.mitgliedId).nameKey != key;
      }

      match /sorten/{sorteId} {
        function bestandGueltig(b) {
          // Einkauf: jede Zeile eine positive ganze Zahl (BES-04).
          return (b.typ != 'einkauf' || (delta('bestand') is int && delta('bestand') > 0))
            // Bestandskorrektur: gezählter Wert gesetzt, Differenz zum Serverstand (BES-06).
            && (b.typ != 'bestandKorrektur' || request.resource.data.bestand == b.gezaehlt);
        }
        function sorteBuchung(typ) {
          let b = buchungDiesesRequests();
          return b != null && b.typ == typ && b.sorteId == sorteId
            && b.name == request.resource.data.name
            && b.preisCents == request.resource.data.preisCents
            && b.aktiv == request.resource.data.aktiv;
        }
        function preisNeu(betrag) {
          return betrag is int && betrag >= 0;
        }

        allow read: if darfLesen();

        // Anlegen (BES-01): Bestand startet bei 0, Einkauf oder Korrektur füllen ihn.
        allow create: if istBierwart()
          && request.resource.data.keys().hasOnly(['name', 'preisCents', 'vorherigerPreisCents', 'aktiv', 'bestand', 'letzteBuchungId', 'reihenfolge'])
          && nameGueltig(request.resource.data.name)
          && preisNeu(request.resource.data.preisCents)
          && request.resource.data.vorherigerPreisCents == null
          && request.resource.data.aktiv == true
          && request.resource.data.bestand == 0
          && request.resource.data.reihenfolge is int
          && sorteBuchung('sorteAngelegt');

        allow update: if
          // Summen aus Buchungen
          (buchungDiesesRequests() != null
            && summeGeaendert('bestand', bestandWirkung(buchungDiesesRequests(), sorteId))
            && bestandGueltig(buchungDiesesRequests()))
          // Ändern und Ausblenden (BES-01). Bei Preisänderung wandert der alte
          // Preis nach vorherigerPreisCents (BES-02).
          || (nurFelder(['name', 'preisCents', 'vorherigerPreisCents', 'aktiv', 'letzteBuchungId'])
            && nameGueltig(request.resource.data.name)
            && preisNeu(request.resource.data.preisCents)
            && request.resource.data.aktiv is bool
            && (request.resource.data.preisCents == resource.data.preisCents
                ? request.resource.data.get('vorherigerPreisCents', null) == resource.data.get('vorherigerPreisCents', null)
                : request.resource.data.vorherigerPreisCents == resource.data.preisCents)
            && sorteBuchung('sorteGeaendert'))
          // Reihenfolge im Raster, ohne Log-Eintrag
          || (istBierwart() && !aufgeloest() && nurFelder(['reihenfolge']) && request.resource.data.reihenfolge is int);
      }

      match /orte/{ortId} {
        function standGueltig(b) {
          // Kassensturz: gezählter Betrag gesetzt, Differenz zum Serverstand (GEL-06).
          return b.typ != 'kassensturz' || request.resource.data.standCents == b.gezaehltCents;
        }
        // Kasse mit Startbetrag (UC-01), Portemonnaie mit 0 (UC-02) oder mit
        // dem Stand des alten Portemonnaies (UC-03).
        function ortNeu(d, b) {
          return ortId == 'kasse'
            ? d.art == 'kasse' && d.uid == null && d.name == 'Kasse'
              && b.typ == 'kasseErstellt' && d.standCents == b.startCents
            : d.art == 'portemonnaie' && d.uid == ortId
              && d.name == nachher('bierwarte', ortId).name
              && (((b.typ == 'kasseErstellt' || b.typ == 'bierwartBeigetreten')
                  && b.stempel.uid == ortId && d.standCents == 0)
                || (b.typ == 'uebernahmeBestaetigt'
                  && b.neueUid == ortId && d.standCents == b.standCents)
                || (b.typ == 'adminWiederhergestellt'
                  && b.neueUid == ortId && d.standCents == 0));
        }
        // Ehemalig (GEL-08): bleibt sichtbar, bis es per Übergabe auf 0 steht.
        function wirdEhemalig(b) {
          return nurFelder(['ehemalig', 'letzteBuchungId'])
            && request.resource.data.ehemalig == true
            && ((b.typ == 'bierwartEntfernt' && b.uid == ortId)
              || (b.typ == 'adminWiederhergestellt' && b.get('alteUid', null) == ortId));
        }
        allow read: if darfLesen();
        allow create: if buchungDiesesRequests() != null
          && request.resource.data.keys().hasOnly(['art', 'uid', 'name', 'standCents', 'ehemalig', 'letzteBuchungId'])
          && request.resource.data.keys().hasAll(['art', 'uid', 'name', 'standCents', 'ehemalig', 'letzteBuchungId'])
          && request.resource.data.ehemalig == false
          && ortNeu(request.resource.data, buchungDiesesRequests());
        allow update: if buchungDiesesRequests() != null
          && ((summeGeaendert('standCents', standWirkung(buchungDiesesRequests(), ortId))
              && standGueltig(buchungDiesesRequests()))
            || wirdEhemalig(buchungDiesesRequests()));
      }

      match /uebernahmen/{anfrageId} {
        function anfrageBuchung(typ) {
          let b = buchungDiesesRequests();
          return b != null && b.typ == typ && b.uebernahmeId == anfrageId;
        }
        function entschieden(status) {
          return nurFelder(['status', 'entschiedenVon', 'entschiedenAm', 'letzteBuchungId'])
            && request.resource.data.status == status
            && request.resource.data.entschiedenVon == request.auth.uid
            && request.resource.data.entschiedenAm == request.time;
        }

        allow read: if darfLesen()
          || (request.auth != null && resource.data.neueUid == request.auth.uid);

        // Anfragen (UC-03, AUTH-07): gültiger Link wie beim Beitreten, für jeden
        // vergebenen Namen außer „Gäste“. Bis zur Entscheidung kein Bierwart.
        allow create: if request.auth != null && !istBierwart()
          && request.resource.data.keys().hasOnly(['neueUid', 'mitgliedId', 'einladungCode', 'status', 'angefragtAm', 'entschiedenVon', 'entschiedenAm', 'letzteBuchungId'])
          && request.resource.data.keys().hasAll(['neueUid', 'mitgliedId', 'einladungCode', 'status', 'angefragtAm', 'entschiedenVon', 'entschiedenAm', 'letzteBuchungId'])
          && request.resource.data.neueUid == request.auth.uid
          && request.resource.data.status == 'offen'
          && request.resource.data.angefragtAm == request.time
          && request.resource.data.entschiedenVon == null
          && request.resource.data.entschiedenAm == null
          && einladungGueltig(request.resource.data.einladungCode)
          && get(pfad('mitglieder', request.resource.data.mitgliedId)).data.get('istGast', false) == false
          && anfrageBuchung('uebernahmeAngefragt');

        allow update: if request.auth != null && resource.data.status == 'offen'
          && (
            // Zurückziehen durch das neue Gerät
            (resource.data.neueUid == request.auth.uid
              && entschieden('zurueckgezogen')
              && anfrageBuchung('uebernahmeZurueckgezogen'))
            // Entscheiden durch einen aktiven Bierwart, solange die Anfrage gilt
            || (istBierwart()
              && request.time < resource.data.angefragtAm + siebenTage()
              && ((entschieden('abgelehnt') && anfrageBuchung('uebernahmeAbgelehnt'))
                || (entschieden('bestaetigt') && anfrageBuchung('uebernahmeBestaetigt')))));
      }

      // ---- Buchungen --------------------------------------------------------

      // Alle Summen-Dokumente, die eine Buchung betrifft, müssen im selben
      // Batch auf sie verweisen. Sonst gäbe es Buchungen ohne Wirkung.
      function verweistAuf(sammlung, id, buchungId) {
        return nachher(sammlung, id).letzteBuchungId == buchungId;
      }
      function felder(d, zusatz) {
        return d.keys().hasOnly(['typ', 'stempel'].concat(zusatz))
          && d.keys().hasAll(['typ', 'stempel'].concat(zusatz));
      }
      // Gebucht wird nur auf aktive Mitglieder; auf „Gäste“ nur bar (KAD-03).
      function mitgliedBuchbar(mitgliedId, offen) {
        let m = nachher('mitglieder', mitgliedId);
        return m.get('entfernt', false) != true && !(offen && m.get('istGast', false) == true);
      }
      // Preis zum Buchungszeitpunkt: aktueller oder vorheriger (BES-02, ADR-0009).
      function preisGueltig(d) {
        let s = nachher('sorten', d.sorteId);
        return d.preisCents is int
          && (d.preisCents == s.preisCents || d.preisCents == s.get('vorherigerPreisCents', -1));
      }

      // Einkauf: Regeln kennen keine Schleifen, deshalb ausgerollt bis 10 Zeilen
      // (ADR-0009: im Emulator gehen 12, 10 als Sicherheitsabstand).
      function zeileGebucht(d, i, buchungId) {
        return d.zeilen.size() <= i || verweistAuf('sorten', d.zeilen.keys()[i], buchungId);
      }
      function zeilenGueltig(d, buchungId) {
        return d.zeilen is map && d.zeilen.size() > 0 && d.zeilen.size() <= 10
          && zeileGebucht(d, 0, buchungId) && zeileGebucht(d, 1, buchungId)
          && zeileGebucht(d, 2, buchungId) && zeileGebucht(d, 3, buchungId)
          && zeileGebucht(d, 4, buchungId) && zeileGebucht(d, 5, buchungId)
          && zeileGebucht(d, 6, buchungId) && zeileGebucht(d, 7, buchungId)
          && zeileGebucht(d, 8, buchungId) && zeileGebucht(d, 9, buchungId);
      }

      // Storno von Strichen und Zahlungen, nur einmal: feste ID
      // storno-{bezugId} (STR-06, offene Frage 24).
      function stornoGueltig(d, buchungId) {
        let alt = get(pfad('buchungen', d.bezugId)).data;
        return buchungId == 'storno-' + d.bezugId
          && d.bezugTyp == alt.typ
          && d.mitgliedId == alt.mitgliedId
          && (alt.typ == 'zahlung'
            ? zahlungsStornoGueltig(d, alt, buchungId)
            : alt.typ in ['strich', 'strichBar'] && strichStornoGueltig(d, alt, buchungId));
      }
      function strichStornoGueltig(d, alt, buchungId) {
        return d.sorteId == alt.sorteId
          && d.preisCents == alt.preisCents
          && verweistAuf('sorten', d.sorteId, buchungId)
          && (d.bezugTyp == 'strich'
              ? felder(d, ['bezugId', 'bezugTyp', 'mitgliedId', 'sorteId', 'preisCents'])
                && verweistAuf('mitglieder', d.mitgliedId, buchungId)
              : felder(d, ['bezugId', 'bezugTyp', 'mitgliedId', 'sorteId', 'preisCents', 'ortId'])
                && ortErlaubt(d.ortId)
                && verweistAuf('orte', d.ortId, buchungId));
      }
      // Zahlung: Saldo steigt wieder, das Geld geht aus dem Ort, in den es
      // ging. Das darf nur, wer diesen Ort verändern darf (ADR-0004).
      function zahlungsStornoGueltig(d, alt, buchungId) {
        return felder(d, ['bezugId', 'bezugTyp', 'mitgliedId', 'betragCents', 'ortId'])
          && d.betragCents == alt.betragCents
          && d.ortId == alt.ortId
          && ortErlaubt(d.ortId)
          && mitgliedBuchbar(d.mitgliedId, false)
          && verweistAuf('mitglieder', d.mitgliedId, buchungId)
          && verweistAuf('orte', d.ortId, buchungId);
      }

      function buchungGueltig(d, buchungId) {
        return (d.typ == 'strich'                                           // STR-02
            && felder(d, ['mitgliedId', 'sorteId', 'preisCents'])
            && mitgliedBuchbar(d.mitgliedId, true)
            && preisGueltig(d)
            && verweistAuf('mitglieder', d.mitgliedId, buchungId)
            && verweistAuf('sorten', d.sorteId, buchungId))
          || (d.typ == 'strichBar'                                          // STR-03
            && felder(d, ['mitgliedId', 'sorteId', 'preisCents', 'ortId'])
            && mitgliedBuchbar(d.mitgliedId, false)
            && preisGueltig(d)
            && ortErlaubt(d.ortId)
            && verweistAuf('sorten', d.sorteId, buchungId)
            && verweistAuf('orte', d.ortId, buchungId))
          || (d.typ == 'storno' && stornoGueltig(d, buchungId))             // STR-04, STR-06
          || (d.typ == 'zahlung'                                            // GEL-02, GEL-03
            && felder(d, ['mitgliedId', 'betragCents', 'ortId'])
            && betragGueltig(d.betragCents)
            && mitgliedBuchbar(d.mitgliedId, false)
            && ortErlaubt(d.ortId)
            && verweistAuf('mitglieder', d.mitgliedId, buchungId)
            && verweistAuf('orte', d.ortId, buchungId))
          || (d.typ == 'einkauf'                                            // BES-04, BES-05
            && felder(d, ['zeilen', 'betragCents', 'ortId'])
            && d.betragCents is int && d.betragCents >= 0
            && ortErlaubt(d.ortId)
            && verweistAuf('orte', d.ortId, buchungId)
            && zeilenGueltig(d, buchungId))
          || (d.typ == 'bestandKorrektur'                                   // BES-06
            && felder(d, ['sorteId', 'gezaehlt', 'differenz'])
            && d.gezaehlt is int && d.differenz is int
            && verweistAuf('sorten', d.sorteId, buchungId))
          || (d.typ == 'uebergabe'                                          // GEL-04
            && felder(d, ['vonOrtId', 'nachOrtId', 'betragCents'])
            && istKassenwart()
            && betragGueltig(d.betragCents)
            && (d.vonOrtId == 'kasse') != (d.nachOrtId == 'kasse')
            && verweistAuf('orte', d.vonOrtId, buchungId)
            && verweistAuf('orte', d.nachOrtId, buchungId))
          || ((d.typ == 'einzahlung' || d.typ == 'auszahlung')              // GEL-05
            && felder(d, ['ortId', 'betragCents', 'grund'])
            && betragGueltig(d.betragCents)
            && d.grund is string && d.grund.size() > 0 && d.grund.size() <= 200
            && ortErlaubt(d.ortId)
            && verweistAuf('orte', d.ortId, buchungId))
          // Stammdaten: Die Rules der Mitglieder und Sorten prüfen die Werte,
          // hier nur Form und Verweis (LOG-01).
          || (d.typ == 'mitgliedAngelegt'                                   // KAD-01
            && felder(d, ['mitgliedId', 'name'])
            && nachher('mitglieder', d.mitgliedId).name == d.name
            && verweistAuf('mitglieder', d.mitgliedId, buchungId))
          || (d.typ == 'mitgliedUmbenannt'                                  // KAD-01, UI-09
            && felder(d, ['mitgliedId', 'nameAlt', 'nameNeu'])
            && get(pfad('mitglieder', d.mitgliedId)).data.name == d.nameAlt
            && nachher('mitglieder', d.mitgliedId).name == d.nameNeu
            && d.nameNeu != d.nameAlt
            && verweistAuf('mitglieder', d.mitgliedId, buchungId))
          || ((d.typ == 'mitgliedEntfernt' || d.typ == 'mitgliedWiederaufgenommen')   // KAD-04, KAD-08
            && felder(d, ['mitgliedId'])
            && verweistAuf('mitglieder', d.mitgliedId, buchungId))
          || ((d.typ == 'sorteAngelegt' || d.typ == 'sorteGeaendert')       // BES-01
            && felder(d, ['sorteId', 'name', 'preisCents', 'aktiv'])
            && verweistAuf('sorten', d.sorteId, buchungId))
          || (d.typ == 'kassensturz'                                        // GEL-06
            && felder(d, ['gezaehltCents', 'differenzCents'])
            && istKassenwart()
            && d.gezaehltCents is int && d.differenzCents is int
            && verweistAuf('orte', 'kasse', buchungId));
      }

      // Übernahme bestätigt (UC-03, AUTH-07, ADR-0008): Mitgliedschaft,
      // Portemonnaie und Rollen gehen 1:1 auf die neue UID über.
      function uebernahmeGueltig(d, buchungId) {
        let anfrage = get(pfad('uebernahmen', d.uebernahmeId)).data;
        let vorher = get(kassePfad()).data;
        let danach = getAfter(kassePfad()).data;
        let alteAktiv = d.alteUid != null && exists(pfad('bierwarte', d.alteUid));
        let umzug = d.alteUid != null && d.alteUid != d.neueUid && exists(pfad('orte', d.alteUid));
        return anfrage.mitgliedId == d.mitgliedId
          && anfrage.neueUid == d.neueUid
          && get(pfad('mitglieder', d.mitgliedId)).data.get('bierwartUid', null) == d.alteUid
          && verweistAuf('uebernahmen', d.uebernahmeId, buchungId)
          && verweistAuf('mitglieder', d.mitgliedId, buchungId)
          && verweistAuf('bierwarte', d.neueUid, buchungId)
          && (!alteAktiv || !existsAfter(pfad('bierwarte', d.alteUid)))
          && d.standCents == (umzug ? get(pfad('orte', d.alteUid)).data.standCents : 0)
          && (!umzug || d.standCents == 0 || verweistAuf('orte', d.alteUid, buchungId))
          && (d.alteUid == d.neueUid || verweistAuf('orte', d.neueUid, buchungId))
          && danach.adminUid == (vorher.adminUid == d.alteUid ? d.neueUid : vorher.adminUid)
          && danach.kassenwartUid == (vorher.kassenwartUid == d.alteUid ? d.neueUid : vorher.kassenwartUid)
          && danach.anzahlBierwarte == vorher.anzahlBierwarte + (alteAktiv ? 0 : 1);
      }

      // ---- Admin-Funktionen ------------------------------------------------

      // Neuer Link: der alte ist im selben Batch ersetzt (ADM-01).
      function linkErneuert(buchungId) {
        let vorher = get(kassePfad()).data;
        let danach = getAfter(kassePfad()).data;
        return danach.letzteBuchungId == buchungId
          && danach.einladungCode != vorher.einladungCode
          && getAfter(/databases/$(database)/documents/einladungen/$(vorher.einladungCode)).data.ersetzt == true;
      }
      // Neuer Wiederherstellungscode: das alte Dokument ist weg (ADM-06, ADM-08).
      function codeGewechselt(buchungId) {
        let vorher = get(kassePfad()).data;
        let danach = getAfter(kassePfad()).data;
        return danach.letzteBuchungId == buchungId
          && danach.wiederherstellungHash != vorher.wiederherstellungHash
          && !existsAfter(/databases/$(database)/documents/wiederherstellung/$(vorher.wiederherstellungHash.toHexString().lower()));
      }
      // Die App sendet den normalisierten Code (siehe Format des Codes).
      function nachweisGueltig(nachweis) {
        return nachweis is string
          && hashing.sha256(nachweis) == get(kassePfad()).data.wiederherstellungHash;
      }
      // Ein Kassenwart ohne aktiven Bierwart-Eintrag geht bei der
      // Wiederherstellung mit (offene Frage 25).
      function kassenwartNachWiederherstellung(alteUid) {
        let kw = get(kassePfad()).data.kassenwartUid;
        return kw == alteUid || !exists(pfad('bierwarte', kw)) ? request.auth.uid : kw;
      }

      // Wiederherstellung ohne Bierwart-Eintrag (ADM-06, UC-03): Er übernimmt
      // ein bestehendes Mitglied oder legt ein neues an. Den Stand des alten
      // Portemonnaies kann er nicht lesen, es wird ehemalig (GEL-08).
      function wiederherstellungMitEintritt(d, buchungId) {
        let vorher = get(kassePfad()).data;
        let danach = getAfter(kassePfad()).data;
        let mitgliedNeu = !exists(pfad('mitglieder', d.mitgliedId));
        let alteAktiv = d.alteUid != null && exists(pfad('bierwarte', d.alteUid));
        let altesOrt = d.alteUid != null && d.alteUid != d.neueUid && exists(pfad('orte', d.alteUid));
        return d.neueUid == request.auth.uid
          && nachweisGueltig(d.nachweis)
          && codeGewechselt(buchungId)
          && (mitgliedNeu
            ? d.alteUid == null
            : get(pfad('mitglieder', d.mitgliedId)).data.get('bierwartUid', null) == d.alteUid
              && get(pfad('mitglieder', d.mitgliedId)).data.get('istGast', false) == false)
          && verweistAuf('mitglieder', d.mitgliedId, buchungId)
          && verweistAuf('bierwarte', d.neueUid, buchungId)
          && (!alteAktiv || !existsAfter(pfad('bierwarte', d.alteUid)))
          && (!altesOrt || (verweistAuf('orte', d.alteUid, buchungId)
            && nachher('orte', d.alteUid).ehemalig == true))
          && (d.alteUid == d.neueUid || verweistAuf('orte', d.neueUid, buchungId))
          && danach.adminUid == request.auth.uid
          && danach.kassenwartUid == kassenwartNachWiederherstellung(d.alteUid)
          && danach.anzahlBierwarte == vorher.anzahlBierwarte + (alteAktiv ? 0 : 1);
      }

      function adminGueltig(d, buchungId) {
        let vorher = get(kassePfad()).data;
        let danach = getAfter(kassePfad()).data;
        return (d.typ == 'einladungErneuert'                                // ADM-01, UC-07
            && felder(d, [])
            && istAdmin()
            && linkErneuert(buchungId))
          // Entfernen (ADM-02, UC-08): bleibt Mitglied, Portemonnaie wird
          // ehemalig (GEL-08), der Link wird erneuert.
          || (d.typ == 'bierwartEntfernt'
            && felder(d, ['uid', 'mitgliedId'])
            && istAdmin()
            && d.uid != vorher.adminUid
            && d.uid != vorher.kassenwartUid
            && get(pfad('bierwarte', d.uid)).data.mitgliedId == d.mitgliedId
            && !existsAfter(pfad('bierwarte', d.uid))
            && verweistAuf('orte', d.uid, buchungId)
            && nachher('orte', d.uid).ehemalig == true
            && linkErneuert(buchungId))
          || (d.typ == 'rolleGeaendert'                                     // ADM-03, UC-09
            && felder(d, ['rolle', 'vonUid', 'nachUid'])
            && istAdmin()
            && d.rolle in ['admin', 'kassenwart']
            && d.vonUid == vorher[d.rolle + 'Uid']
            && d.nachUid == danach[d.rolle + 'Uid']
            && d.nachUid != d.vonUid
            && exists(pfad('bierwarte', d.nachUid))
            && danach.letzteBuchungId == buchungId)
          || (d.typ == 'kasseUmbenannt'                                     // ADM-04
            && felder(d, ['nameAlt', 'nameNeu'])
            && istAdmin()
            && d.nameAlt == vorher.name
            && d.nameNeu == danach.name
            && d.nameNeu != d.nameAlt
            && danach.letzteBuchungId == buchungId)
          || (d.typ == 'kasseAufgeloest'                                    // ADM-05, UC-10
            && felder(d, [])
            && istAdmin()
            && danach.aufgeloest == true
            && danach.letzteBuchungId == buchungId)
          // Wiederherstellung als Bierwart (ADM-06, UC-04): der bisherige
          // Admin bleibt normaler Bierwart.
          || (d.typ == 'adminWiederhergestellt'
            && felder(d, ['nachweis'])
            && nachweisGueltig(d.nachweis)
            && codeGewechselt(buchungId)
            && danach.adminUid == request.auth.uid
            && danach.kassenwartUid == kassenwartNachWiederherstellung(null)
            && danach.anzahlBierwarte == vorher.anzahlBierwarte)
          || (d.typ == 'wiederherstellungscodeErneuert'                     // ADM-08
            && felder(d, [])
            && istAdmin()
            && codeGewechselt(buchungId));
      }

      // Verwaltung durch einen Bierwart. Die Rules der betroffenen Dokumente
      // prüfen die Werte, hier Form, Verweise und Vorbedingungen (LOG-01).
      function verwaltungGueltig(d, buchungId) {
        return (d.typ == 'uebernahmeAbgelehnt'                              // UC-03
            && felder(d, ['uebernahmeId', 'mitgliedId'])
            && nachher('uebernahmen', d.uebernahmeId).mitgliedId == d.mitgliedId
            && verweistAuf('uebernahmen', d.uebernahmeId, buchungId))
          || (d.typ == 'uebernahmeBestaetigt'                               // UC-03, AUTH-07
            && felder(d, ['uebernahmeId', 'mitgliedId', 'alteUid', 'neueUid', 'standCents'])
            && uebernahmeGueltig(d, buchungId))
          // Austreten (UC-05, AUTH-09): Portemonnaie leer; Admin und Kassenwart
          // übergeben vorher, außer sie sind der letzte Bierwart.
          || (d.typ == 'ausgetreten'
            && felder(d, ['mitgliedId'])
            && d.mitgliedId == get(pfad('bierwarte', request.auth.uid)).data.mitgliedId
            && !existsAfter(pfad('bierwarte', request.auth.uid))
            && get(pfad('orte', request.auth.uid)).data.standCents == 0
            && (get(kassePfad()).data.anzahlBierwarte == 1
              || (get(kassePfad()).data.adminUid != request.auth.uid
                && get(kassePfad()).data.kassenwartUid != request.auth.uid))
            && getAfter(kassePfad()).data.letzteBuchungId == buchungId);
      }

      // Buchungen von Nutzern, die (noch) kein Bierwart sind.
      function ohneMitgliedschaftGueltig(d, buchungId) {
        return (d.typ == 'kasseErstellt'                                    // UC-01, AUTH-02
            && felder(d, ['kassenName', 'startCents', 'mitgliedId', 'name'])
            && !exists(kassePfad())
            && d.startCents is int && d.startCents >= 0
            && getAfter(kassePfad()).data.name == d.kassenName
            && getAfter(kassePfad()).data.letzteBuchungId == buchungId
            && nachher('bierwarte', request.auth.uid).mitgliedId == d.mitgliedId
            && nachher('mitglieder', d.mitgliedId).name == d.name
            && verweistAuf('bierwarte', request.auth.uid, buchungId)
            && verweistAuf('mitglieder', d.mitgliedId, buchungId)
            && verweistAuf('mitglieder', 'gaeste', buchungId)
            && verweistAuf('orte', 'kasse', buchungId)
            && verweistAuf('orte', request.auth.uid, buchungId))
          || (d.typ == 'bierwartBeigetreten'                                // UC-02
            && felder(d, ['mitgliedId', 'name'])
            && nachher('bierwarte', request.auth.uid).mitgliedId == d.mitgliedId
            && nachher('mitglieder', d.mitgliedId).name == d.name
            && getAfter(kassePfad()).data.letzteBuchungId == buchungId
            && verweistAuf('bierwarte', request.auth.uid, buchungId)
            && verweistAuf('mitglieder', d.mitgliedId, buchungId)
            && verweistAuf('orte', request.auth.uid, buchungId))
          || ((d.typ == 'uebernahmeAngefragt' || d.typ == 'uebernahmeZurueckgezogen')   // UC-03
            && felder(d, ['uebernahmeId', 'mitgliedId'])
            && nachher('uebernahmen', d.uebernahmeId).mitgliedId == d.mitgliedId
            && nachher('uebernahmen', d.uebernahmeId).neueUid == request.auth.uid
            && verweistAuf('uebernahmen', d.uebernahmeId, buchungId))
          || (d.typ == 'adminWiederhergestellt'                             // ADM-06, UC-03
            && felder(d, ['nachweis', 'mitgliedId', 'alteUid', 'neueUid'])
            && wiederherstellungMitEintritt(d, buchungId));
      }

      // Name im Stempel: der des Bierwarts. Wer gerade Bierwart wird, steht
      // erst nach dem Batch fest. Eine Übernahme-Anfrage trägt den Namen, um
      // den es geht.
      function stempelName(d) {
        return istBierwart() ? get(pfad('bierwarte', request.auth.uid)).data.name
          : istOderWirdBierwart() ? nachher('bierwarte', request.auth.uid).name
          : get(pfad('mitglieder', d.mitgliedId)).data.name;
      }
      function stempelGueltig(s, name) {
        return s.keys().hasOnly(['uid', 'name', 'am', 'geraetAm'])
          && s.uid == request.auth.uid
          && s.am == request.time
          && s.name == name;
      }
      // Wer eine Übernahme anfragt oder zurückzieht, ist noch kein Bierwart und
      // darf die Mitglieder nicht lesen. Er kennt den Namen nur so, wie er ihn
      // eingetippt hat; der Stempel muss deshalb nur im Namensschlüssel passen
      // (UC-03, AUTH-07).
      function stempelPasst(d) {
        return !istOderWirdBierwart()
            && (d.typ == 'uebernahmeAngefragt' || d.typ == 'uebernahmeZurueckgezogen')
          ? stempelGueltig(d.stempel, d.stempel.get('name', null))
            && nameGueltig(d.stempel.name)
            && nameKey(d.stempel.name) == get(pfad('mitglieder', d.mitgliedId)).data.nameKey
          : stempelGueltig(d.stempel, stempelName(d));
      }

      // Nachweis für die Wiederherstellung ohne Bierwart-Eintrag (ADM-06,
      // UC-03, ADR-0010): Schritt 1 belegt den Code und gibt Lesezugriff,
      // Schritt 2 ist die Buchung adminWiederhergestellt. Danach gilt ein
      // neuer Code, und der Nachweis ist wertlos. Bierwarte sehen ihn nicht.
      match /wiederherstellungen/{uid} {
        function nachweisNeu() {
          let d = request.resource.data;
          return request.auth != null && request.auth.uid == uid
            && d.keys().hasOnly(['nachweis', 'angelegtAm'])
            && d.keys().hasAll(['nachweis', 'angelegtAm'])
            && d.angelegtAm == request.time
            && nachweisGueltig(d.nachweis)
            && !aufgeloest();
        }
        allow read: if (request.auth != null && request.auth.uid == uid) || loeschtAdmin();
        allow create, update: if nachweisNeu();
        allow delete: if request.auth != null && request.auth.uid == uid;
      }

      match /buchungen/{buchungId} {
        allow read: if darfLesen();
        allow create: if request.auth != null
          && stempelPasst(request.resource.data)
          && !aufgeloest()
          && (istBierwart()
            ? buchungGueltig(request.resource.data, buchungId)
              || verwaltungGueltig(request.resource.data, buchungId)
              || adminGueltig(request.resource.data, buchungId)
            : ohneMitgliedschaftGueltig(request.resource.data, buchungId));
        // Gelöscht wird nur beim Auflösen (LOG-02, ADM-05), siehe oben.
        allow update: if false;
      }
    }

    // ---- Außerhalb der Kassen ----------------------------------------------
    // Einladungen und Wiederherstellung: Wer den Code kennt, darf das Dokument
    // lesen, aber niemand darf auflisten (AUTH-05).

    match /einladungen/{code} {
      function kasseDanach() {
        return getAfter(/databases/$(database)/documents/kassen/$(request.resource.data.kasseId)).data;
      }
      allow get: if request.auth != null;
      function kasseVorher(kasseId) {
        return /databases/$(database)/documents/kassen/$(kasseId);
      }
      // Neuer Code in diesem Request: beim Erstellen der Kasse (UC-01) oder
      // beim Erneuern (ADM-01, ADM-02); die Kassen-Rules prüfen den Admin.
      function codeNeu() {
        return !exists(kasseVorher(request.resource.data.kasseId))
          ? kasseDanach().erstelltAm == request.time
          : get(kasseVorher(request.resource.data.kasseId)).data.einladungCode != code;
      }
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['kasseId', 'kassenName', 'anzahlBierwarte', 'erstelltAm', 'ersetzt'])
        && request.resource.data.keys().hasAll(['kasseId', 'kassenName', 'anzahlBierwarte', 'erstelltAm', 'ersetzt'])
        && codeNeu()
        && kasseDanach().einladungCode == code
        && request.resource.data.kassenName == kasseDanach().name
        && request.resource.data.anzahlBierwarte == kasseDanach().anzahlBierwarte
        && request.resource.data.erstelltAm == request.time
        && request.resource.data.ersetzt == false;
      allow update: if request.auth != null && (
        // Name und Anzahl folgen der Kasse (AUTH-05)
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['anzahlBierwarte', 'kassenName'])
          && request.resource.data.anzahlBierwarte
            == getAfter(kasseVorher(resource.data.kasseId)).data.anzahlBierwarte
          && request.resource.data.kassenName
            == getAfter(kasseVorher(resource.data.kasseId)).data.name)
        // Ersetzt, sobald die Kasse einen anderen Code hat (ADM-01)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ersetzt'])
          && request.resource.data.ersetzt == true
          && getAfter(kasseVorher(resource.data.kasseId)).data.einladungCode != code));
      // Beim Auflösen (ADM-05)
      allow delete: if request.auth != null
        && get(kasseVorher(resource.data.kasseId)).data.get('aufgeloest', false) == true
        && get(kasseVorher(resource.data.kasseId)).data.adminUid == request.auth.uid;
    }

    match /wiederherstellung/{hashHex} {
      function kasseDanach() {
        return getAfter(/databases/$(database)/documents/kassen/$(request.resource.data.kasseId)).data;
      }
      allow get: if request.auth != null;
      function kasseVorher(kasseId) {
        return /databases/$(database)/documents/kassen/$(kasseId);
      }
      // Beim Erstellen der Kasse (UC-01, AUTH-03) oder mit neuem Code (ADM-06,
      // ADM-08); die Kassen-Rules prüfen Admin bzw. Nachweis. toHexString()
      // liefert Großbuchstaben, die Dokument-ID ist klein geschrieben.
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['kasseId'])
        && kasseDanach().wiederherstellungHash.toHexString().lower() == hashHex
        && (!exists(kasseVorher(request.resource.data.kasseId))
          ? kasseDanach().erstelltAm == request.time
          : get(kasseVorher(request.resource.data.kasseId)).data.wiederherstellungHash.toHexString().lower() != hashHex);
      // Der alte Code fällt weg, sobald die Kasse einen neuen hat, oder beim
      // Auflösen (ADM-05).
      allow delete: if request.auth != null
        && (get(kasseVorher(resource.data.kasseId)).data.get('aufgeloest', false) == true
          ? get(kasseVorher(resource.data.kasseId)).data.adminUid == request.auth.uid
          : getAfter(kasseVorher(resource.data.kasseId)).data.wiederherstellungHash.toHexString().lower() != hashHex);
    }

    // Zeigt auf die Kasse des Nutzers. Release 1: eine Kasse je Nutzer (AUTH-14
    // erst Release 4). Gültig nur, solange er dort Bierwart ist.
    match /users/{uid} {
      function bierwartIn(kasseId) {
        return existsAfter(/databases/$(database)/documents/kassen/$(kasseId)/bierwarte/$(uid));
      }
      function eintragGueltig() {
        return request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['kasseId'])
          && request.resource.data.kasseId is string
          && bierwartIn(request.resource.data.kasseId);
      }
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if eintragGueltig();
      allow update: if eintragGueltig() && !bierwartIn(resource.data.kasseId);
      allow delete: if request.auth != null && request.auth.uid == uid && !bierwartIn(resource.data.kasseId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
