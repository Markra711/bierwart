{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "bier-wart",
          "appId": "1:797384576516:android:ae8d4feb3c1e2ae0fa6f51",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "bier-wart",
          "configurations": {
            "android": "1:797384576516:android:ae8d4feb3c1e2ae0fa6f51",
            "ios": "1:797384576516:ios:bc02e350b566c332fa6f51"
          }
        }
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "hosting/public",
    "rewrites": [
      {
        "source": "/j/**",
        "destination": "/j.html"
      },
      {
        "source": "/datenschutz",
        "destination": "/datenschutz.html"
      },
      {
        "source": "/konto-loeschen",
        "destination": "/konto-loeschen.html"
      },
      {
        "source": "/nutzungsbedingungen",
        "destination": "/nutzungsbedingungen.html"
      }
    ],
    "headers": [
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "hosting": {
      "port": 5000
    },
    "ui": {
      "enabled": true
    },
    "singleProjectMode": true
  }
}
