<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Bierwart kennt nur das dunkle Theme. Beide Themen liegen auf dem Token bg,
         im hellen wie im dunklen Systemmodus. -->
    <!-- Während der Prozess startet, bis Flutter das erste Bild zeichnet -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Hinter der Flutter-Oberfläche, solange die App läuft -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/bierwart_bg</item>
    </style>
</resources>
